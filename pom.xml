<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.stefanrichterhuber</groupId>
    <artifactId>wasmtimejavang-parent</artifactId>
    <version>6.0.4-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>wasmtime-java-ng (parent)</name>
    <description>Java bindings for Wasmtime via a native Rust bridge, and the WIT-driven code generation tooling around it.</description>
    <url>https://github.com/StefanRichterHuber/wasmtime-java-ng</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Stefan Richter-Huber</name>
            <email>stefan@richter-huber.de</email>
            <organization>Stefan Richter-Huber</organization>
            <organizationUrl>https://github.com/StefanRichterHuber</organizationUrl>
        </developer>
    </developers>

    <modules>
        <module>wasmtimejavang</module>
        <module>wit-parser</module>
        <module>wit-codegen-maven-plugin</module>
        <module>wasmtimejavang-wasi-io</module>
        <module>wasmtimejavang-wasi-clocks</module>
        <module>wasmtimejavang-wasi-random</module>
        <module>wasmtimejavang-wasi-cli</module>
        <module>wasmtimejavang-wasi-filesystem</module>
        <module>wasmtimejavang-wasi-sockets</module>
        <module>wasmtimejavang-wasi-http</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>

        <log4j.version>2.26.1</log4j.version>
        <junit-jupiter.version>6.1.3</junit-jupiter.version>
        <jimfs.version>1.3.2</jimfs.version>
        <mockito.version>5.24.0</mockito.version>
        <gson.version>2.13.1</gson.version>

        <!-- Cargo profile for development. Change to 'release' for release builds -->
        <cargo.profile>dev</cargo.profile>
        <cargo.profile.folder>debug</cargo.profile.folder>

        <!-- Optimize wasm modules shipped within the artifacts with wasm-opt. Only during release -->
        <wasm-opt.skip>true</wasm-opt.skip>

        <!-- Spotbugs fail on error set to false-->
        <spotbugs.failOnError>false</spotbugs.failOnError>
    </properties>


    <scm>
        <connection>scm:git:https://github.com/StefanRichterHuber/wasmtime-ng</connection>
        <developerConnection>scm:git:https://github.com/StefanRichterHuber/wasmtime-ng</developerConnection>
        <url>https://github.com/StefanRichterHuber/wasmtime-ng</url>
        <!-- Set to the release tag by the release workflow, HEAD during development -->
        <tag>HEAD</tag>
    </scm>

    <build>
        <plugins>
            <plugin>
                <!-- Releases are published by .github/workflows/release.yml: deploy only writes a
                local staging repository (altDeploymentRepository), which is verified, bundled and
                uploaded to Maven Central by the workflow -->
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.4</version>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>add-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <!-- Update this path if your generator uses a specific subfolder -->
                                <source>${project.build.directory}/generated-sources/wit-components</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Profiles -->
    <profiles>
        <!-- Release profile -->
        <profile>
            <id>release</id>
            <activation>
                <property>
                    <name>performRelease</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <cargo.profile>release</cargo.profile>
                <cargo.profile.folder>release</cargo.profile.folder>
                <wasm-opt.skip>false</wasm-opt.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>


        <profile>
            <id>spotbugs</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.9.8.2</version>
                        <executions>
                            <execution>
                                <id>check</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <plugins>
                                <plugin>
                                    <groupId>com.h3xstream.findsecbugs</groupId>
                                    <artifactId>findsecbugs-plugin</artifactId>
                                    <version>1.14.0</version>
                                </plugin>
                            </plugins>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>