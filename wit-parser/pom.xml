<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.stefanrichterhuber</groupId>
        <artifactId>wasmtimejavang-parent</artifactId>
        <version>6.0.4-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>

    <artifactId>wit-parser</artifactId>

    <name>wit-parser</name>
    <description>The Rust wit-parser crate compiled to a WASI module and run on wasmtime-java-ng, resolving a WIT file's interfaces and functions into Java objects. Build-time only -- not used at WASM runtime.</description>
    <url>https://github.com/StefanRichterHuber/wasmtime-java-ng</url>

    <dependencies>
        <!-- Runtime executing the platform independent wit-parser WASI module -->
        <dependency>
            <groupId>io.github.stefanrichterhuber</groupId>
            <artifactId>wasmtimejavang</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Decodes the JSON the WASI module writes to stdout -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <!-- A single wasm32-wasip1 module serves every platform: no cross-compilation
                    (and no per-platform profiles) necessary, the platform specific part is
                    wasmtimejavang's native library. Always built with the release profile: the
                    module is shipped inside the jar, and a dev build is ~30 times larger
                    (debuginfo). -->
                    <execution>
                        <id>build wit-parser wasm module</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <executable>cargo</executable>
                            <workingDirectory>
                                ${project.basedir}/src/main/rust/wit-parser-binding</workingDirectory>
                            <arguments>
                                <argument>build</argument>
                                <argument>--profile</argument>
                                <argument>release</argument>
                                <argument>--target</argument>
                                <argument>wasm32-wasip1</argument>
                                <argument>--target-dir</argument>
                                <argument>${project.build.directory}/rust</argument>
                            </arguments>
                            <environmentVariables>
                                <RUSTUP_TOOLCHAIN>stable</RUSTUP_TOOLCHAIN>
                            </environmentVariables>
                        </configuration>
                    </execution>

                    <!-- Optimizes the wasm module with wasm-opt (binaryen), saves ~25% of its
                    size. Optimizes the copy within the classes folder in place, so tests and the
                    jar alike use it. Only runs if wasm-opt.skip is false: during releases, or with
                    the wasm-opt profile. -->
                    <execution>
                        <id>wasm-opt wit-parser wasm module</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>process-classes</phase>
                        <configuration>
                            <skip>${wasm-opt.skip}</skip>
                            <executable>wasm-opt</executable>
                            <arguments>
                                <argument>-O4</argument>
                                <argument>
                                    ${project.build.outputDirectory}/io/github/stefanrichterhuber/witparser/wit-parser-binding.wasm</argument>
                                <argument>-o</argument>
                                <argument>
                                    ${project.build.outputDirectory}/io/github/stefanrichterhuber/witparser/wit-parser-binding.wasm</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <!-- Copy the module built above into the classes, where WitParser loads it
                    from the classpath -->
                    <execution>
                        <id>copy-wit-parser-wasm</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <!-- Always copy fresh, the wasm-opt profile optimizes the copy in place -->
                            <overwrite>true</overwrite>
                            <outputDirectory>
                                ${project.build.directory}/classes/io/github/stefanrichterhuber/witparser</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>
                                        ${project.build.directory}/rust/wasm32-wasip1/release</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>wit-parser-binding.wasm</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Runs wasm-opt outside of releases too (see the 'wasm-opt wit-parser wasm module'
        execution) -->
        <profile>
            <id>wasm-opt</id>
            <properties>
                <wasm-opt.skip>false</wasm-opt.skip>
            </properties>
        </profile>
    </profiles>
</project>
